Bootstrap: docker
From: condaforge/miniforge3:latest

%post
    cat <<'EOF' > /tmp/environment.yml
name: fenicsx-new
channels:
  - conda-forge
dependencies:
  - python=3.13
  - fenics-dolfinx=0.9.0
  - mpich=4.3.2
  - pyvista=0.48.0
  - pip=25.1
  - dolfinx_mpc=0.9.3
  - gmsh==4.13.1
  - python-gmsh

  - pip:
    - scipy==1.17.1
    - tqdm==4.67.3
    - meshio==5.3.5
    - scikit-learn==1.8.0
EOF
    mamba env create -f /tmp/environment.yml
    mamba clean --all --yes

%environment
    export PATH=/opt/conda/envs/fenicsx-new/bin:$PATH
    export CONDA_DEFAULT_ENV=fenicsx-new
    export CONDA_PREFIX=/opt/conda/envs/fenicsx-new

%runscript
    exec python "$@"
