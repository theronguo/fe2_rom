Bootstrap: docker
From: condaforge/miniforge3:latest

%post
    cat <<'EOF' > /tmp/environment.yml
name: fe2_rom_env
channels:
  - conda-forge
dependencies:
  - python=3.14.4
  - fenics-dolfinx=0.10.0
  - dolfinx_mpc=0.10.5
  - gmsh=4.15.2
  - python-gmsh=4.15.2
  - pip

  - pip:
    - scipy==1.17.1
    - tqdm==4.67.3
    - meshio==5.3.5
    - scikit-learn==1.8.0
    - jax==0.10.0
    - jaxmat==0.0.3
EOF
    mamba env create -f /tmp/environment.yml
    mamba clean --all --yes
    find /opt/conda/envs/fe2_rom_env -name "_sysconfigdata_*.py" -exec \
        sed -i "s|'CC': '[^']*'|'CC': 'gcc'|g; s|'CXX': '[^']*'|'CXX': 'g++'|g" {} \;

%environment
    export PATH=/opt/conda/envs/fe2_rom_env/bin:$PATH

%runscript
    exec python "$@"
